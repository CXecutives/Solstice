/* Every engine setting read from the environment (HV_*), one line each: the single source for core/knobs.{h,c},
   ios/Henge/EngineKnobs.generated.swift, KNOBS.md and the CI gates (tools/knobs.py).

   KNOB(field, "HV_NAME", TYPE, default, low, high, "purpose")
     field     hv_knob.field in C, EngineKnob.field (camel case) in Swift; HV_NAME is "HV_" + its upper case.
     FLAG      on when the variable is set at all, whatever its value (even 0).
     BOOL      0 off; any other number, or an empty value, on.
     INT       a whole number (atoi); outside low..high it falls back to the default (said once, at the load).
     DOUBLE    a number (atof), with low..high as for INT.
     HEX       a 64-bit number in hex (strtoull base 16), as an address.
     STR       the text itself (NULL or the default when unset).
   Set the environment, then hv_knobs_load() (each machine creation, the Mac tool's main, the app's EngineTuning).
   Keep each line on one line: tools/knobs.py reads them. */

/* ---- The translator and the dispatcher (several can also be set while a Mac runs: hv_knob_set) ---- */
KNOB(superblocks, "HV_SUPERBLOCKS", BOOL, 0, 0, 0, "Blocks continue past direct branches into one longer translation.")
KNOB(groups, "HV_GROUPS", BOOL, 0, 0, 0, "Neighbouring memory accesses checked as one group.")
KNOB(no_ras, "HV_NO_RAS", BOOL, 0, 0, 0, "Every return goes through the indirect-branch cache (no return prediction).")
KNOB(k2, "HV_K2", BOOL, 0, 0, 0, "Testing: each block in one part (hot and cold code together).")
KNOB(k3, "HV_K3", BOOL, 0, 0, 0, "Testing: every guest register spilled around helper calls.")
/* Table-major unless asked: 9-20% faster in 5 of 6 paired rounds of the mix. */
KNOB(tlbt, "HV_TLBT", BOOL, 1, 0, 0, "TLB laid out table-major (0: entry-major).")
KNOB(jit_cap, "HV_JIT_CAP", INT, 0, 0, 65536, "Testing: MB of the code region used from the start (0: all of it).")
/* The exact check costs ~13% of the code (Mac 2026-11-09: 296-300 against 259-261 bytes a block); without it Golden
   Gate's boot and login send 80-240K such accesses a second to the helper on the phone, whose code cache fills every
   40-60 s: worth a phone A/B (HV_RECHECK 0 vs 1 over a login), not a Mac one (~7K such accesses/s). */
KNOB(recheck, "HV_RECHECK", BOOL, 1, 0, 0, "Exact check for accesses in a page's last 15 bytes in their out-of-line path.")
KNOB(sync_wait, "HV_SYNC_WAIT", BOOL, 0, 0, 0, "A CPU waiting for TLB acknowledgements sleeps after 64 spins.")
/* Off unless asked since 2026-11-09: a checked skip on the phone found a kept user entry out of date (a stack page, no
   mapping), the stale state that flush exists to retire (xnu reusing a hardware ASID, which can leave every process's
   kept entries stale, not just the incoming one's). It was worth ~3% on a process-spawn loop; not worth guest memory. */
KNOB(switch_flush, "HV_SWITCH_FLUSH", INT, 0, 0, 3, "Skip the local TLB flush xnu issues after a process switch (1-3: ways of checking it).")
KNOB(range_drop, "HV_RANGE_DROP", INT, 0, 0, 1048576, "TLB range invalidations of up to this many pages in one pass (0: off).")
/* Off: no measured gain (Mac mix 24.1 s either way, 2026-11-08); the tests pass with it on (HV_MOVIMM=1 make test). */
KNOB(movimm, "HV_MOVIMM", BOOL, 0, 0, 0, "Constants built in registers instead of loaded from the literal pool.")
KNOB(predstat, "HV_PREDSTAT", BOOL, 0, 0, 0, "Measuring: every access through the C helper, with prediction statistics.")
/* On unless asked: the Mac bench (2026-11-08) posted 130-400 raced remote drops/s with it against 710-1370 without
   (most walks a drop met were of other pages), and the phone's login storm waits up to 24% of a CPU. */
KNOB(walk_log, "HV_WALK_LOG", BOOL, 1, 0, 0, "Remote TLB drops skip CPUs whose page walks did not touch the page.")
KNOB(hoist_check, "HV_HOIST_CHECK", BOOL, 0, 0, 0, "The exit check of backward branches hoisted out of loops.")
/* On unless asked: a code change used to drop every CPU's whole branch cache (~100/s with JavaScriptCore's JIT on the
   Mac bench, 300-390K refills/s after); now only the page's targets (Mac 2026-11-09: resets 195 -> 2/s, a JIT check of
   200 recompiled functions correct; bench times the same within noise). */
KNOB(ijc_pages, "HV_IJC_PAGES", BOOL, 1, 0, 0, "A code change drops only that page's branch-cache targets.")
KNOB(dns_proxy, "HV_DNS_PROXY", BOOL, 1, 0, 0, "The guest's DNS through the host's resolver.")
KNOB(wfi_spin, "HV_WFI_SPIN", INT, 0, 0, 1000000, "Microseconds an idle CPU watches for work before sleeping.")
KNOB(flush, "HV_FLUSH", INT, 0, 0, 2, "Disk flush: 0 fsync, 1 none, 2 F_BARRIERFSYNC.")
KNOB(no_fast_resume, "HV_NO_FAST_RESUME", FLAG, 0, 0, 0, "Every exception entry and return through the dispatcher.")
KNOB(wfe_spin, "HV_WFE_SPIN", FLAG, 0, 0, 0, "A WFE always leaves for the dispatcher instead of waiting in place.")
KNOB(no_stash, "HV_NO_STASH", FLAG, 0, 0, 0, "A process switch drops the user TLB entries instead of stashing them.")
KNOB(ic_ivau, "HV_IC_IVAU", FLAG, 0, 0, 0, "IC IVAU drops the page's translations (as before they were kept).")
KNOB(ic_flush, "HV_IC_FLUSH", FLAG, 0, 0, 0, "IC IALLU drops every translation (as before they were kept).")
KNOB(exit_checks, "HV_EXIT_CHECKS", FLAG, 0, 0, 0, "Debugging: every chained exit checks for an exit request.")
KNOB(no_xchain, "HV_NO_XCHAIN", FLAG, 0, 0, 0, "Branches to another page never chain.")
KNOB(inline_xjump, "HV_INLINE_XJUMP", FLAG, 0, 0, 0, "Each branch to another page does its own cache lookup instead of the shared thunk.")
KNOB(c_excl, "HV_C_EXCL", FLAG, 0, 0, 0, "Debugging: every exclusive access through the C helper.")
KNOB(tlbi_leaves, "HV_TLBI_LEAVES", FLAG, 0, 0, 0, "Every TLBI ends its block, as before.")
KNOB(slow_mem, "HV_SLOW_MEM", FLAG, 0, 0, 0, "Debugging: every load and store through the C helper.")
KNOB(big_lock, "HV_BIG_LOCK", FLAG, 0, 0, 0, "Debugging: one CPU in guest code at a time.")
KNOB(jit_poison, "HV_JIT_POISON", FLAG, 0, 0, 0, "Debugging: freed code poisoned, and each block's flush generation checked as it runs.")
KNOB(code_check, "HV_CODE_CHECK", FLAG, 0, 0, 0, "Debugging: which code pages changed since they were translated.")
KNOB(ijc_debug, "HV_IJC_DEBUG", FLAG, 0, 0, 0, "Debugging: what came before branch-cache misses that were cached.")
KNOB(psci_log, "HV_PSCI_LOG", FLAG, 0, 0, 0, "Debugging: every PSCI call.")
KNOB(block_dump, "HV_BLOCK_DUMP", STR, NULL, 0, 0, "Measuring: a file for sampled translated blocks (guest and host words, for bench/hvdis.py).")
KNOB(block_dump_every, "HV_BLOCK_DUMP_EVERY", INT, 64, 0, INT_MAX, "Measuring: HV_BLOCK_DUMP keeps every Nth block.")
KNOB(prof_fn, "HV_PROF_FN", STR, "run", 0, 0, "Measuring: the function the profiler shows per offset.")
KNOB(kva_hist, "HV_KVA_HIST", FLAG, 0, 0, 0, "Measuring: which kernel VAs get TLB fills, per bucket.")
KNOB(kva_base, "HV_KVA_BASE", HEX, 0xfffffe0000000000ull, 0, 0, "Measuring: where HV_KVA_HIST's buckets start.")
KNOB(kva_shift, "HV_KVA_SHIFT", INT, 30, 17, 40, "Measuring: log2 of the bytes in each HV_KVA_HIST bucket.")
KNOB(stats, "HV_STATS", INT, 0, 0, 86400, "Seconds between engine stats lines in the log (0: none).")
KNOB(stats_deep, "HV_STATS_DEEP", BOOL, 0, 0, 0, "The stats lines with the costly diagnostics too.")

/* ---- The display ---- */
