KNOB(saving_hz, "HV_SAVING_HZ", INT, 0, 0, 120, "Frames a second shown while saving power (hot device); 0: every frame.")
KNOB(pvg_vblank, "HV_PVG_VBLANK", BOOL, 1, 0, 0, "The display's refresh interrupts (0: none).")
KNOB(pvg_trace_file, "HV_PVG_TRACE_FILE", STR, NULL, 0, 0, "GPU command trace while this file exists (checked as it runs).")
KNOB(pvg_trace, "HV_PVG_TRACE", INT, 0, 0, INT_MAX, "Mac tool: the graphics device's register accesses (level).")
KNOB(pvg_ops, "HV_PVG_OPS", FLAG, 0, 0, 0, "Debugging: the first of each channel command the guest sends.")
KNOB(pvg_no_metal, "HV_PVG_NO_METAL", FLAG, 0, 0, 0, "Testing: the graphics device without its Metal replay.")
KNOB(pvg_lite_log, "HV_PVG_LITE_LOG", FLAG, 0, 0, 0, "Debugging: the graphics device's own log.")
KNOB(pvg_tally, "HV_PVG_TALLY", FLAG, 0, 0, 0, "Measuring: counts of the guest's graphics commands.")
KNOB(pvg_half, "HV_PVG_HALF", STR, NULL, 0, 0, "\"linear\": half-float surfaces shown as linear at start.")
KNOB(pvg_fail_libs, "HV_PVG_FAIL_LIBS", FLAG, 0, 0, 0, "Testing: every shader library refused, as an OS that cannot load them does.")
KNOB(pvg_no_relabel, "HV_PVG_NO_RELABEL", FLAG, 0, 0, 0, "Shader libraries never relabelled for iOS.")
KNOB(pvg_relabel, "HV_PVG_RELABEL", INT, 0, 0, 3, "Testing: every shader library relabelled at this stage from the start (0: as needed).")
KNOB(pvg_relabel_quiet, "HV_PVG_RELABEL_QUIET", FLAG, 0, 0, 0, "No log line for libraries loaded relabelled at the stage asked for.")
KNOB(shader_dump, "HV_SHADER_DUMP", INT, -1, -1, INT_MAX, "Shader libraries kept while tracing: 0 none, other numbers all and blend states (-1: the first relabelled ones).")
KNOB(pvg_archive, "HV_PVG_ARCHIVE", STR, NULL, 0, 0, "Saved pipelines: \"0\" none, \"reset\" start again.")
KNOB(pvg_archive_mb, "HV_PVG_ARCHIVE_MB", INT, 768, 1, INT_MAX, "MB of saved pipelines at most.")
KNOB(pvg_heap_log, "HV_PVG_HEAP_LOG", FLAG, 0, 0, 0, "Debugging: each GPU heap the guest makes.")
KNOB(pvg_host_dump, "HV_PVG_HOST_DUMP", STR, NULL, 0, 0, "Debugging: file prefix for the first host surfaces before the guest's pixels.")
KNOB(pvg_surface_dump, "HV_PVG_SURFACE_DUMP", STR, NULL, 0, 0, "Debugging: file prefix for the first multi-plane surfaces.")
KNOB(pvg_desc_dump, "HV_PVG_DESC_DUMP", FLAG, 0, 0, 0, "Debugging: texture descriptors as read.")
KNOB(pvg_planar_copy, "HV_PVG_PLANAR_COPY", FLAG, 0, 0, 0, "Every plane of multi-plane surfaces copied, not just the first.")
KNOB(pvg_plane0, "HV_PVG_PLANE0", FLAG, 0, 0, 0, "Multi-plane surfaces read from plane 0 only.")
KNOB(pvg_passdump, "HV_PVG_PASSDUMP", INT, 0, 0, INT_MAX, "Debugging: the first N render pass records, raw and as read.")
KNOB(pvg_sync, "HV_PVG_SYNC", FLAG, 0, 0, 0, "Debugging: each GPU command buffer waited for.")
KNOB(pvg_cursor_log, "HV_PVG_CURSOR_LOG", FLAG, 0, 0, 0, "Debugging: pointer glyphs and visibility.")
KNOB(pvg_gpu_test, "HV_PVG_GPU_TEST", FLAG, 0, 0, 0, "Mac tool: the phone's GPU path, drawn into a layer for screenshots.")
KNOB(pvg_shot, "HV_PVG_SHOT", STR, NULL, 0, 0, "Mac tool: a file for screenshots of the drawable.")
KNOB(pvg_shot_secs, "HV_PVG_SHOT_SECS", DOUBLE, 5, 0.01, 86400, "Mac tool: seconds between HV_PVG_SHOT screenshots.")
KNOB(shot_secs, "HV_SHOT_SECS", DOUBLE, 5, 0.01, 86400, "Mac tool: seconds between named screenshots (for timing a boot).")
KNOB(color_probe, "HV_COLOR_PROBE", FLAG, 0, 0, 0, "Measuring: what the display is told and shown, for colour problems.")
KNOB(color_probe_dir, "HV_COLOR_PROBE_DIR", STR, NULL, 0, 0, "Measuring: HV_COLOR_PROBE's folder (default Documents/colorprobe).")
KNOB(color_probe_secs, "HV_COLOR_PROBE_SECS", DOUBLE, 0, 0, 86400, "Measuring: seconds between HV_COLOR_PROBE captures (0: on trigger only).")
KNOB(color_probe_metrics_secs, "HV_COLOR_PROBE_METRICS_SECS", DOUBLE, 15, 0, 86400, "Measuring: seconds between HV_COLOR_PROBE metrics lines.")
KNOB(color_probe_max, "HV_COLOR_PROBE_MAX", INT, 8, 0, INT_MAX, "Measuring: HV_COLOR_PROBE captures at most.")

