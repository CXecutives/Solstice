KNOB(virtio_cfg_log, "HV_VIRTIO_CFG_LOG", FLAG, 0, 0, 0, "Debugging: virtio queue sizes and config reads.")
KNOB(pci_log, "HV_PCI_LOG", INT, -1, -1, INT_MAX, "Debugging: config reads of this PCI slot (-1: none).")
KNOB(input_log, "HV_INPUT_LOG", FLAG, 0, 0, 0, "Debugging: what the guest's input driver asks.")
KNOB(snd_log, "HV_SND_LOG", FLAG, 0, 0, 0, "Debugging: the sound device.")
KNOB(vusb_log, "HV_VUSB_LOG", FLAG, 0, 0, 0, "Debugging: the USB device port.")
KNOB(xhci_log, "HV_XHCI_LOG", FLAG, 0, 0, 0, "Debugging: the USB controller.")
KNOB(avp_log, "HV_AVP_LOG", FLAG, 0, 0, 0, "Debugging: the AVP devices.")

