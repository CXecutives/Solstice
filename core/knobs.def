KNOB(log_console, "HV_LOG_CONSOLE", STR, NULL, 0, 0, "App: a copy of the log on the original stderr (for devicectl --console).")
KNOB(trace, "HV_TRACE", FLAG, 0, 0, 0, "Tests: every block traced.")
