KNOB(no_sound, "HV_NO_SOUND", FLAG, 0, 0, 0, "No sound device.")
KNOB(write_cache, "HV_WRITE_CACHE", BOOL, 1, 0, 0, "Disk writes through the host's cache (0: F_NOCACHE, for the restore).")
KNOB(blk_stats, "HV_BLK_STATS", INT, -1, -1, INT_MAX, "Measuring: disk stats every N seconds (0: 10; -1: none).")
